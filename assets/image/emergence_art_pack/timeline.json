  "subtitles": [
    {
      "id": 1,
      "start": 9.5,
      "end": 14,
      "start_frame": 228,
      "end_frame": 336,
      "zh": "在这只鸟的体内，一个看不见的世界正在改变。",
      "en": "Within this bird, an unseen world was changing.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 2,
      "start": 14,
      "end": 16.5,
      "start_frame": 336,
      "end_frame": 396,
      "zh": "一场微小的感染扩散开来。",
      "en": "A small infection spread.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 3,
      "start": 20,
      "end": 23,
      "start_frame": 480,
      "end_frame": 552,
      "zh": "每只鸟跟随着附近的同伴。",
      "en": "Each bird follows its neighbours.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 4,
      "start": 23,
      "end": 25,
      "start_frame": 552,
      "end_frame": 600,
      "zh": "保持距离。",
      "en": "Keeping distance.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 5,
      "start": 25,
      "end": 27,
      "start_frame": 600,
      "end_frame": 648,
      "zh": "一同转向。",
      "en": "Turning together.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 6,
      "start": 27,
      "end": 29,
      "start_frame": 648,
      "end_frame": 696,
      "zh": "留在群体附近。",
      "en": "Staying close.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 7,
      "start": 29,
      "end": 33.5,
      "start_frame": 696,
      "end_frame": 804,
      "zh": "秩序，从这些微小的行动中涌现。",
      "en": "From these small actions, order emerges.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 8,
      "start": 36.5,
      "end": 41,
      "start_frame": 876,
      "end_frame": 984,
      "zh": "这只鸟死于急性肺炎。",
      "en": "This bird died of acute pneumonia.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 9,
      "start": 41.5,
      "end": 45,
      "start_frame": 996,
      "end_frame": 1080,
      "zh": "鸟群仍在继续飞行。",
      "en": "The flock continued its flight.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 10,
      "start": 56,
      "end": 59,
      "start_frame": 1344,
      "end_frame": 1416,
      "zh": "在下方，另一个世界也在运行。",
      "en": "Below, another world moves.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 11,
      "start": 60,
      "end": 65,
      "start_frame": 1440,
      "end_frame": 1560,
      "zh": "人们相遇、交换、合作与竞争。",
      "en": "People meet, exchange, cooperate, and compete.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 12,
      "start": 66,
      "end": 70.5,
      "start_frame": 1584,
      "end_frame": 1692,
      "zh": "他们的生活彼此交织，",
      "en": "Their lives intertwine,",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 13,
      "start": 70.5,
      "end": 75,
      "start_frame": 1692,
      "end_frame": 1800,
      "zh": "形成任何一个人都无法独自创造的社会。",
      "en": "shaping a society no one person could create alone.",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 14,
      "start": 77,
      "end": 80,
      "start_frame": 1848,
      "end_frame": 1920,
      "zh": "世代之间，这些联系",
      "en": "Across generations, these connections",
      "timing_status": "draft_pending_narration"
    },
    {
      "id": 15,
      "start": 80,
      "end": 85.5,
      "start_frame": 1920,
      "end_frame": 2052,
      "zh": "逐渐形成城市、文化与文明。",
      "en": "grow into cities, cultures, and civilizations.",
      "timing_status": "draft_pending_narration"
    }
